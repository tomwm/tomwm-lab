# All optional. The app works with no .env file at all.
#
# The Garmin Personal API key is NOT stored here by default. Run
#   npm run garmin:key
# to save it to ~/.config/garmin-me/api-key (chmod 600), outside the repo.
# Setting this variable overrides that file:
# GARMIN_PERSONAL_API_KEY=
#
# Where the local cache (SQLite) is kept. Default:
#   ~/Library/Application Support/garmin-me
# GARMIN_ME_DATA_DIR=
