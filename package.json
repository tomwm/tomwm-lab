{
  "name": "tomwm-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "!apps/garmin-me"
  ],
  "scripts": {
    "build": "node build.js",
    "dev:policy-lines": "npm -w apps/policy-lines run dev",
    "dev:uk-gov-network-graph": "npm -w apps/uk-gov-network-graph run dev",
    "dev:smile": "npm -w apps/smile run dev",
    "dev:sexual-elf": "npm -w apps/sexual-elf run dev",
    "dev:history-timeline": "npm -w apps/history-timeline run dev",
    "dev:splitz": "npm -w apps/splitz run dev",
    "dev:garmin-me": "npm --prefix apps/garmin-me run dev"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  }
}
